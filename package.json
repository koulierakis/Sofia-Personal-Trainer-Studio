{
  "name": "sofia-personal-trainer-studio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "images:audit": "python tools/image-library/library.py audit",
    "images:validate": "python tools/image-library/library.py validate",
    "images:import": "python tools/image-library/library.py import",
    "images:comfy": "python tools/image-library/comfy.py",
    "images:test": "python -m unittest discover -s tools/image-library -p \"test_*.py\"",
    "images:review": "python tools/image-library/review.py",
    "images:bulk": "python tools/image-library/bulk_storyboards.py"
  },
  "engines": {
    "node": ">=20"
  }
}
